<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:models="clr-namespace:Fix_It.Models"
             x:Class="Fix_It.Views.NotificationsPage"
             Title="Notifications"
             BackgroundColor="{StaticResource PageBackground}">

    <!-- Simple read-only history, grouped by date — no unread tracking or "Mark all read",
         since there's no per-user state for that and only one notification type exists today. -->
    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="16">

            <Label Text="Request updates" TextColor="{StaticResource Gray500}" Margin="0,0,0,8" />

            <Label Text="No notifications yet." TextColor="{StaticResource Gray500}" IsVisible="{Binding HasNone}" />

            <VerticalStackLayout Spacing="10" IsVisible="{Binding HasToday}">
                <Label Text="TODAY" Style="{StaticResource FieldLabel}" />
                <VerticalStackLayout Spacing="10" BindableLayout.ItemsSource="{Binding TodayNotifications}">
                    <BindableLayout.ItemTemplate>
                        <DataTemplate x:DataType="models:NotificationLogEntry">
                            <Border BackgroundColor="{StaticResource CardBackground}"
                                    Stroke="{StaticResource BorderGray}"
                                    StrokeShape="RoundRectangle 12"
                                    StrokeThickness="1"
                                    Padding="16">
                                <VerticalStackLayout Spacing="4">
                                    <Label Text="{Binding Title}" FontFamily="OpenSansSemibold" FontSize="16" />
                                    <Label Text="{Binding Message}" TextColor="{StaticResource Gray500}" FontSize="13" />
                                    <Label Text="{Binding TimestampUtc, StringFormat='{0:h:mm tt}'}" TextColor="{StaticResource Gray400}" FontSize="12" />
                                </VerticalStackLayout>
                            </Border>
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </VerticalStackLayout>
            </VerticalStackLayout>

            <VerticalStackLayout Spacing="10" IsVisible="{Binding HasYesterday}">
                <Label Text="YESTERDAY" Style="{StaticResource FieldLabel}" />
                <VerticalStackLayout Spacing="10" BindableLayout.ItemsSource="{Binding YesterdayNotifications}">
                    <BindableLayout.ItemTemplate>
                        <DataTemplate x:DataType="models:NotificationLogEntry">
                            <Border BackgroundColor="{StaticResource CardBackground}"
                                    Stroke="{StaticResource BorderGray}"
                                    StrokeShape="RoundRectangle 12"
                                    StrokeThickness="1"
                                    Padding="16">
                                <VerticalStackLayout Spacing="4">
                                    <Label Text="{Binding Title}" FontFamily="OpenSansSemibold" FontSize="16" />
                                    <Label Text="{Binding Message}" TextColor="{StaticResource Gray500}" FontSize="13" />
                                    <Label Text="{Binding TimestampUtc, StringFormat='{0:h:mm tt}'}" TextColor="{StaticResource Gray400}" FontSize="12" />
                                </VerticalStackLayout>
                            </Border>
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </VerticalStackLayout>
            </VerticalStackLayout>

            <VerticalStackLayout Spacing="10" IsVisible="{Binding HasEarlier}">
                <Label Text="EARLIER" Style="{StaticResource FieldLabel}" />
                <VerticalStackLayout Spacing="10" BindableLayout.ItemsSource="{Binding EarlierNotifications}">
                    <BindableLayout.ItemTemplate>
                        <DataTemplate x:DataType="models:NotificationLogEntry">
                            <Border BackgroundColor="{StaticResource CardBackground}"
                                    Stroke="{StaticResource BorderGray}"
                                    StrokeShape="RoundRectangle 12"
                                    StrokeThickness="1"
                                    Padding="16">
                                <VerticalStackLayout Spacing="4">
                                    <Label Text="{Binding Title}" FontFamily="OpenSansSemibold" FontSize="16" />
                                    <Label Text="{Binding Message}" TextColor="{StaticResource Gray500}" FontSize="13" />
                                    <Label Text="{Binding TimestampUtc, StringFormat='{0:MMM d, h:mm tt}'}" TextColor="{StaticResource Gray400}" FontSize="12" />
                                </VerticalStackLayout>
                            </Border>
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </VerticalStackLayout>
            </VerticalStackLayout>

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
