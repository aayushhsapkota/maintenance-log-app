<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:models="clr-namespace:Fix_It.Models"
             x:Class="Fix_It.Views.IssueListPage"
             Title="All Reports"
             BackgroundColor="{StaticResource PageBackground}">

    <Grid>

        <!-- Shown only once someone's actually signed in (IsSignedIn set at the start of
             LoadReportsAsync). Before that — the brief window before the login modal covers
             this page — the ActivityIndicator below is what's visible instead. -->
        <Grid Padding="20" RowDefinitions="Auto,*" RowSpacing="16" IsVisible="{Binding IsSignedIn}">

        <Grid Grid.Row="0" ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
            <VerticalStackLayout Grid.Column="0" Spacing="2">
                <Label Text="All Reports"
                       FontFamily="OpenSansSemibold"
                       FontSize="26"
                       HorizontalOptions="Start" />
                <Label Text="Every issue that's been submitted"
                       TextColor="{StaticResource Gray500}" />
            </VerticalStackLayout>

            <!-- Bell icon — entry point to NotificationsPage. Style="{StaticResource
                 SecondaryButton}" is the Named style; the fixed square size overriding that
                 style's HeightRequest is set directly on this element (Element-level). -->
            <Button Grid.Column="1"
                    Text="&#128276;"
                    Style="{StaticResource SecondaryButton}"
                    Command="{Binding GoToNotificationsCommand}"
                    HeightRequest="44"
                    WidthRequest="44"
                    FontSize="18"
                    Padding="0"
                    VerticalOptions="Center" />

            <Button Grid.Column="2"
                    Text="+ Report"
                    Style="{StaticResource PrimaryButton}"
                    Command="{Binding GoToReportCommand}"
                    HeightRequest="44"
                    WidthRequest="110"
                    FontSize="14"
                    VerticalOptions="Center" />
        </Grid>

        <CollectionView Grid.Row="1" ItemsSource="{Binding Reports}">
            <CollectionView.EmptyView>
                <VerticalStackLayout VerticalOptions="Center" HorizontalOptions="Center" Spacing="8">
                    <Label Text="No issues have been reported yet."
                           TextColor="{StaticResource Gray500}"
                           HorizontalTextAlignment="Center" />
                </VerticalStackLayout>
            </CollectionView.EmptyView>
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="models:IssueReport">
                    <Border BackgroundColor="{StaticResource CardBackground}"
                            Stroke="{StaticResource BorderGray}"
                            StrokeShape="RoundRectangle 12"
                            StrokeThickness="1"
                            Padding="16"
                            Margin="0,0,0,12">
                        <Border.GestureRecognizers>
                            <!-- This template's own BindingContext is the IssueReport item, so
                                 the Command has to be redirected up to the page's ViewModel via
                                 BindingContext.GoToDetailCommand; CommandParameter stays bound
                                 to the item itself (the default, local BindingContext). -->
                            <TapGestureRecognizer Command="{Binding BindingContext.GoToDetailCommand, Source={RelativeSource AncestorType={x:Type ContentPage}}}"
                                                   CommandParameter="{Binding .}" />
                        </Border.GestureRecognizers>
                        <VerticalStackLayout Spacing="4">
                            <Grid ColumnDefinitions="*,Auto">
                                <Label Grid.Column="0"
                                       Text="{Binding Title}"
                                       FontFamily="OpenSansSemibold"
                                       FontSize="16" />

                                <Border Grid.Column="1"
                                        BackgroundColor="{StaticResource ErrorRed}"
                                        StrokeShape="RoundRectangle 20"
                                        Padding="8,3"
                                        IsVisible="{Binding IsOpen}">
                                    <Label Text="Open" TextColor="{StaticResource White}" FontSize="11" FontFamily="OpenSansSemibold" />
                                </Border>
                                <Border Grid.Column="1"
                                        BackgroundColor="{StaticResource SuccessGreen}"
                                        StrokeShape="RoundRectangle 20"
                                        Padding="8,3"
                                        IsVisible="{Binding IsResolved}">
                                    <Label Text="Resolved" TextColor="{StaticResource White}" FontSize="11" FontFamily="OpenSansSemibold" />
                                </Border>
                            </Grid>
                            <Label Text="{Binding Location}"
                                   TextColor="{StaticResource Gray500}"
                                   FontSize="13" />
                            <Label Text="{Binding Priority, StringFormat='Priority: {0}'}"
                                   TextColor="{StaticResource Primary}"
                                   FontSize="13" />
                            <Label Text="{Binding CreatedByEmail, StringFormat='Reported by {0}'}"
                                   TextColor="{StaticResource Gray400}"
                                   FontSize="12" />
                            <Label Text="{Binding CreatedAtUtc, StringFormat='Submitted {0:MMM d, yyyy h:mm tt}'}"
                                   TextColor="{StaticResource Gray400}"
                                   FontSize="12" />
                        </VerticalStackLayout>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

        </Grid>

        <ActivityIndicator IsRunning="{Binding IsCheckingAuth}"
                            IsVisible="{Binding IsCheckingAuth}"
                            HorizontalOptions="Center"
                            VerticalOptions="Center" />

    </Grid>

</ContentPage>
